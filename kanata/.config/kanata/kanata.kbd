;; kanata config — laptop.
;; Caps: tap = Esc, hold = LCtrl.
;; Space: tap = Space, hold = nav layer (hjkl arrows).

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    "Air75 V3-1"
    "Air75 V3-2"
    "Air75 V3-3"
    "Air75 V3 Dongle"
  )
)

(defvar
  tap-time 200
  hold-time 170
)

(defalias
  cap-ctl  (tap-hold $tap-time $hold-time esc lctl)
  spc-nav  (tap-hold-release $tap-time $hold-time spc (layer-while-held nav))
)

(defsrc
  caps h j k l spc
)

(deflayer base
  @cap-ctl h    j    k     l     @spc-nav
)

(deflayer nav
  _        left down up    right _
)
