;; kanata config — laptop HRM mirror for Voyager.
;; BOTTOM-ROW GACS variant: home row stays plain so vim hjkl has no
;; HRM latency. Mods live on Z X C V / M , . / instead of A S D F / J K L ;
;;
;; tap-hold-release-keys = same-hand suppression for HRM letters.
;; concurrent-tap-hold   = HRM keys can stack (e.g. C+V+t for Ctrl+Shift+T).
;; chordsv2              = simultaneous press for guaranteed Shift+letter.
;; nav layer (space hold) = retained for non-vim contexts (browsers, etc.).

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  concurrent-tap-hold yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    "Air75 V3-2"
  )
)

(defvar
  tap-time 200
  hold-time 170
  chord-time 35

  right-keys (
    6 7 8 9 0 - =
    y u i o p [ ] \
    h j k l ; '
    n m , . /
  )

  left-keys (
    grv 1 2 3 4 5
    q w e r t
    a s d f g
    z x c v b
    spc
  )
)

(defalias
  cap        esc
  z-gui      (tap-hold-release-keys $tap-time $hold-time z lmet $right-keys)
  x-alt      (tap-hold-release-keys $tap-time $hold-time x lalt $right-keys)
  c-ctl      (tap-hold-release-keys $tap-time $hold-time c lctl $right-keys)
  v-sft      (tap-hold-release-keys $tap-time $hold-time v lsft $right-keys)
  m-sft      (tap-hold-release-keys $tap-time $hold-time m rsft $left-keys)
  comma-ctl  (tap-hold-release-keys $tap-time $hold-time , rctl $left-keys)
  dot-alt    (tap-hold-release-keys $tap-time $hold-time . ralt $left-keys)
  slash-gui  (tap-hold-release-keys $tap-time $hold-time / rmet $left-keys)

  spc-nav    (tap-hold-release $tap-time $hold-time spc (layer-while-held nav))
)

;; chordsv2: simultaneous-press Shift+letter via V (left shift) or M (right shift).
;; Each chord = (HRM-shift + opposite-hand key) within chord-time -> emit S-key.
(defchordsv2
  (v y) S-y $chord-time first-release (nav)
  (v u) S-u $chord-time first-release (nav)
  (v i) S-i $chord-time first-release (nav)
  (v o) S-o $chord-time first-release (nav)
  (v p) S-p $chord-time first-release (nav)
  (v h) S-h $chord-time first-release (nav)
  (v j) S-j $chord-time first-release (nav)
  (v k) S-k $chord-time first-release (nav)
  (v l) S-l $chord-time first-release (nav)
  (v n) S-n $chord-time first-release (nav)
  (v m) S-m $chord-time first-release (nav)
  (v 6) S-6 $chord-time first-release (nav)
  (v 7) S-7 $chord-time first-release (nav)
  (v 8) S-8 $chord-time first-release (nav)
  (v 9) S-9 $chord-time first-release (nav)
  (v 0) S-0 $chord-time first-release (nav)
  (v -) S-- $chord-time first-release (nav)
  (v =) S-= $chord-time first-release (nav)
  (v [) S-[ $chord-time first-release (nav)
  (v ]) S-] $chord-time first-release (nav)
  (v ;) S-; $chord-time first-release (nav)
  (v ') S-' $chord-time first-release (nav)
  (v ,) S-, $chord-time first-release (nav)
  (v .) S-. $chord-time first-release (nav)
  (v /) S-/ $chord-time first-release (nav)

  (m q) S-q $chord-time first-release (nav)
  (m w) S-w $chord-time first-release (nav)
  (m e) S-e $chord-time first-release (nav)
  (m r) S-r $chord-time first-release (nav)
  (m t) S-t $chord-time first-release (nav)
  (m a) S-a $chord-time first-release (nav)
  (m s) S-s $chord-time first-release (nav)
  (m d) S-d $chord-time first-release (nav)
  (m f) S-f $chord-time first-release (nav)
  (m g) S-g $chord-time first-release (nav)
  (m z) S-z $chord-time first-release (nav)
  (m x) S-x $chord-time first-release (nav)
  (m c) S-c $chord-time first-release (nav)
  ;; (m v) intentionally omitted: same key set as (v m) -> S-m wins.
  (m b) S-b $chord-time first-release (nav)
  (m 1) S-1 $chord-time first-release (nav)
  (m 2) S-2 $chord-time first-release (nav)
  (m 3) S-3 $chord-time first-release (nav)
  (m 4) S-4 $chord-time first-release (nav)
  (m 5) S-5 $chord-time first-release (nav)
  (m grv) S-grv $chord-time first-release (nav)
)

(defsrc
  caps z x c v h j k l m , . / spc
)

(deflayer base
  @cap @z-gui @x-alt @c-ctl @v-sft h j k l @m-sft @comma-ctl @dot-alt @slash-gui @spc-nav
)

(deflayer nav
  _    _      _      _      _     left down up right _      _          _        _          _
)
