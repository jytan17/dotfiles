// Zellij configuration
// Replicates tmux experience with Ctrl-Space prefix

// Auto-grant plugin permissions (skip permission prompts)
auto_accept_plugin_permissions true

theme "catppuccin-mocha"

// Use default shell
default_shell "fish"

// Mouse support
mouse_mode true

// Copy on select
copy_on_select true

// Clickable URLs (Ctrl-click to open)
clickable_urls true

// Scrollback
scroll_buffer_size 50000

// Session serialization (equivalent to tmux-resurrect/continuum)
session_serialization true
serialize_pane_viewport true

// Simplified UI
simplified_ui false
pane_frames false

// Default layout (uses zjstatus status bar)
default_layout "default"

keybinds clear-defaults=true {
    // =====================
    // Normal mode (always active)
    // =====================
    shared_except "locked" {
        // Navigation: Ctrl-h/j/k/l (vim-zellij-navigator aware)
        bind "Ctrl h" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "left";
                move_mod "ctrl";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
                move_mod "ctrl";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
                move_mod "ctrl";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "right";
                move_mod "ctrl";
            };
        }

        // Resize: Alt-h/j/k/l (vim-zellij-navigator aware)
        bind "Alt h" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "resize";
                payload "left";
                resize_mod "alt";
            };
        }
        bind "Alt j" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "resize";
                payload "down";
                resize_mod "alt";
            };
        }
        bind "Alt k" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "resize";
                payload "up";
                resize_mod "alt";
            };
        }
        bind "Alt l" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "resize";
                payload "right";
                resize_mod "alt";
            };
        }
    }

    // =====================
    // Ctrl-Space prefix bindings (tmux-like)
    // Using "tmux" mode as a prefix layer
    // =====================
    shared_except "locked" {
        // Prefix key: Ctrl-Space enters tmux mode
        bind "Ctrl Space" { SwitchToMode "tmux"; }
    }

    tmux {
        // Splits (matching tmux: | vertical, - horizontal)
        bind "|" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "-" { NewPane "Down"; SwitchToMode "Normal"; }

        // New tab (like tmux prefix+c)
        bind "c" { NewTab; SwitchToMode "Normal"; }

        // Zoom toggle (prefix+m, matching tmux config)
        bind "m" { ToggleFocusFullscreen; SwitchToMode "Normal"; }

        // Pane swapping (prefix+< and prefix+>)
        // Using brackets since < > need shift
        bind "[" { MovePaneBackwards; SwitchToMode "Normal"; }
        bind "]" { MovePane; SwitchToMode "Normal"; }

        // Tab navigation
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // Quick tab switching (prefix+Space = last tab, like tmux last-window)
        bind "Space" { ToggleTab; SwitchToMode "Normal"; }

        // Session picker (prefix+w, like tmux choose-tree)
        bind "w" { LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }; SwitchToMode "Normal"; }

        // Close pane (prefix+x with confirmation via zellij's built-in)
        bind "x" { CloseFocus; SwitchToMode "Normal"; }

        // Close tab (prefix+X)
        bind "X" { CloseTab; SwitchToMode "Normal"; }

        // Rename tab (prefix+$, like tmux rename-session)
        bind "$" { SwitchToMode "RenameTab"; TabNameInput 0; }

        // Rename pane (prefix+.)
        bind "." { SwitchToMode "RenamePane"; PaneNameInput 0; }

        // Floating pane toggle (like aerospace alt+shift+f)
        bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; }

        // Convert current pane between floating/embedded
        bind "F" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }

        // Toggle pane frames (borders with pane title)
        bind "b" { TogglePaneFrames; SwitchToMode "Normal"; }

        // Stacked/layout (like aerospace alt+/ and alt+,)
        bind "/" { NextSwapLayout; SwitchToMode "Normal"; }
        bind "," { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }

        // Pane focus within stack (next/previous)
        bind "n" { FocusNextPane; SwitchToMode "Normal"; }
        bind "p" { FocusPreviousPane; SwitchToMode "Normal"; }

        // Move focused pane in direction (like aerospace alt+shift+h/j/k/l)
        bind "H" { MovePane "Left"; SwitchToMode "Normal"; }
        bind "J" { MovePane "Down"; SwitchToMode "Normal"; }
        bind "K" { MovePane "Up"; SwitchToMode "Normal"; }
        bind "L" { MovePane "Right"; SwitchToMode "Normal"; }

        // Enter resize mode (for fine-grained control)
        bind "r" { SwitchToMode "Resize"; }

        // Detach (prefix+d, like tmux)
        bind "d" { Detach; }

        // Scroll/search mode (prefix+[, like tmux copy mode)
        bind "[" { SwitchToMode "Scroll"; }

        // Enter locked mode (prefix+g)
        bind "g" { SwitchToMode "Locked"; }

        // Cancel prefix
        bind "Esc" { SwitchToMode "Normal"; }
        bind "Ctrl Space" { SwitchToMode "Normal"; }
    }

    // =====================
    // Scroll / copy mode (like tmux vi-copy)
    // =====================
    scroll {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl d" { HalfPageScrollDown; }
        bind "Ctrl u" { HalfPageScrollUp; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Esc" "q" { SwitchToMode "Normal"; }
    }

    entersearch {
        bind "Enter" { SwitchToMode "Search"; }
        bind "Esc" { SwitchToMode "Normal"; }
    }

    search {
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Esc" "q" { SwitchToMode "Normal"; }
    }

    // =====================
    // Resize mode (prefix+r to enter, repeatable h/j/k/l)
    // =====================
    resize {
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "Esc" "Enter" { SwitchToMode "Normal"; }
    }

    // =====================
    // Rename modes
    // =====================
    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }

    // =====================
    // Locked mode (passthrough all keys)
    // =====================
    locked {
        bind "Ctrl Space" { SwitchToMode "Normal"; }
    }
}
