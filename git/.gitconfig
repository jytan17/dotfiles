[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    wrap-max-lines = unlimited

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

# Local overrides (machine-specific settings like user, credentials)
[include]
    path = ~/.gitconfig.local
