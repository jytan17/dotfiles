{
  "collaboration_panel": {
    "button": false
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "git_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "show_edit_predictions": false,
  "active_pane_modifiers": {
    "inactive_opacity": 0.85,
  },
  "vim_mode": true,
  "ui_font_size": 17,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha - No Italics",
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "terminal": {
    "dock": "right",
    "font_family": "JetBrainsMono Nerd Font Mono",
    "blinking": "on",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "format_on_save": "on",
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
  },
  "tab_bar": {
    "show": true,
  },
  "project_panel": {
    "dock": "left",
    "hide_root": true,
    "starts_open": true,
    "auto_fold_dirs": true,
    "indent_size": 20,
  },
  "relative_line_numbers": "enabled",
  "auto_signature_help": false,
  "show_signature_help_after_edits": false,
  "markdown_preview": {
    "limit_content_width": false,
  },
}
