[
  {
    "context": "Editor && vim_mode == insert && showing_completions",
    "bindings": {
      "tab": "editor::ContextMenuNext",
      "shift-tab": "editor::ContextMenuPrevious",
      "ctrl-y": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "Dock || Editor || Workspace",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g w": "vim::HelixJumpToWord",
    },
  },
  {
    "context": "Dock || Editor || Terminal || Workspace",
    "bindings": {
      "ctrl-shift-h": "vim::ResizePaneLeft",
      "ctrl-shift-j": "vim::ResizePaneDown",
      "ctrl-shift-k": "vim::ResizePaneUp",
      "ctrl-shift-l": "vim::ResizePaneRight",
      "ctrl-shift-0": "vim::ResetPaneSizes",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // Navigation
      "l": "project_panel::OpenPermanent",
      "h": "project_panel::CollapseSelectedEntry",
      "-": "project_panel::SelectParent",

      // Splits
      "s": "project_panel::OpenSplitHorizontal",
      "v": "project_panel::OpenSplitVertical",

      // File operations
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",

      // Clipboard
      "y": "project_panel::Copy",
      "x": "project_panel::Cut",
      "p": "project_panel::Paste",

      // Copy paths
      "y p": "workspace::CopyRelativePath",
      "y shift-p": "workspace::CopyPath",

      // Panel management
      "q": "workspace::ToggleLeftDock",
      "escape": "workspace::ActivateNextPane",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-,": "terminal_panel::Toggle",
      "alt-g": ["task::Spawn", { "task_name": "Lazygit" }],
      "alt-d": ["task::Spawn", { "task_name": "Lazydocker" }],
      "alt-y": ["task::Spawn", { "task_name": "Yazi" }],
      "alt-t": ["task::Spawn", { "task_name": "Terminal" }],
    },
  },
  {
    "context": "MarkdownPreview",
    "bindings": {
      "j": "markdown::ScrollDown",
      "k": "markdown::ScrollUp",
    },
  },
]
